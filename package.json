{
  "name": "@waronsaas/sheets",
  "version": "0.1.0",
  "description": "wOS Sheets: spreadsheets a small team owns instead of rents. Formulas, tabs, charts, comments, live editing, and your own AI works the sheet over MCP. Self-host free, or host with us.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/warOnSaaS/sheets"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "SHEETS_OPEN_SIGNUP=1 node server.mjs",
    "build": "node scripts/build-screens.mjs",
    "test": "node --test --test-timeout=180000 --test-concurrency=1 test/*.test.mjs",
    "test:pg": "SHEETS_TEST_PG=${SHEETS_TEST_PG:-postgres://postgres:sheets@localhost:55497/sheets} node --test --test-timeout=180000 --test-concurrency=1 test/tools.test.mjs test/postgres.test.mjs",
    "tools:json": "node scripts/tools-json.mjs",
    "sync-kit": "node scripts/sync-kit.mjs",
    "shots": "node scripts/shots.mjs",
    "check:clean": "node scripts/check-clean.mjs",
    "check:suite": "node scripts/suite-check.mjs",
    "check": "node scripts/tools-json.mjs --check && node scripts/build-screens.mjs --check && node ~/wos-suite/packages/manifest/bin/check.mjs . && npm test && node scripts/check-clean.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hyperformula": "^3.4.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "ssf": "^0.11.2",
    "ws": "^8.22.0",
    "yjs": "^13.6.33",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  },
  "exports": {
    ".": "./server.mjs",
    "./tools.json": "./tools.json",
    "./wos-app.json": "./wos-app.json"
  }
}
